dv:
  network: {{ ndnd_dv_network | tojson }}
  router: {{ ndnd_router_prefix | tojson }}
  keychain: dir:///config/keys
  trust_anchors:
    - {{ ndnd_root_cert_name | tojson }}
  trust_schema: dv-schema.tlv
  neighbors:
    {% set peers = namespace(count=0) %}
    {% for link in ndnd_links %}
    {% if inventory_hostname == link.a or inventory_hostname == link.b %}
    {% set peer_name = link.b if inventory_hostname == link.a else link.a %}
    {% set peer = hostvars[peer_name] %}
    - uri: {{ ("udp4://" + peer.host_ip + ":" + str(ndnd_udp_port)) | tojson }}
    {% set peers.count = peers.count + 1 %}
    {% endif %}
    {% endfor %}
    {% if peers.count == 0 %}
    []
    {% endif %}